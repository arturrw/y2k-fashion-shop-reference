---
import type { Product } from '../db/schema';
interface Props { product: Product; index?: number }
const { product: p, index = 0 } = Astro.props;
const no = String(index + 1).padStart(3, '0');
---
<a href={`/product/${p.id}`} class="group reveal block" style={`--i:${Math.min(index, 12)}`}>
  <div class="relative aspect-[3/4] overflow-hidden bg-surface-card">
    {p.imageUrl
      ? <img src={p.imageUrl} alt="" loading="lazy" transition:name={`product-${p.id}`} class="size-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]" />
      : <div transition:name={`product-${p.id}`} class="size-full bg-gradient-to-br from-secondary to-stone"></div>}
    <span aria-hidden="true" class="eyebrow absolute top-3 left-3 bg-canvas px-1.5 py-0.5 text-ink">No. {no}</span>
    <span aria-hidden="true" class="eyebrow absolute inset-x-0 bottom-0 translate-y-full bg-ink py-2.5 text-center text-canvas transition-transform duration-300 group-hover:translate-y-0">View piece</span>
  </div>
  <div class="flex items-start justify-between gap-3 pt-3 pb-6">
    <p class="min-w-0 text-sm leading-snug">{p.name}</p>
    <span class="shrink-0 font-mono text-sm">${p.price}</span>
  </div>
</a>
