---
import CartButton from './CartButton';
import SearchButton from './SearchButton';
import AccountButton from './AccountButton';
import MobileMenu from './MobileMenu';
import { ChevronDown } from 'lucide-react';
import { NAV } from '../lib/catalog';

const TICKER = ['Free worldwide shipping', 'Collection 01 — Cyber Y2K', 'Archive pieces restocked weekly', 'Returns within 30 days'];
---
<header transition:persist="site-header" class="group/header sticky top-0 z-50 border-b border-ink bg-canvas transition-[background-color,backdrop-filter] duration-300 data-[scrolled]:border-ink/20 data-[scrolled]:bg-canvas/55 data-[scrolled]:backdrop-blur-md">
  <div class="overflow-hidden bg-ink py-1.5 text-canvas transition-colors duration-300 group-data-[scrolled]/header:bg-ink/75" aria-hidden="true">
    <div class="ticker-track eyebrow flex w-max gap-12 whitespace-nowrap">
      {Array.from({ length: 2 }).flatMap(() => TICKER.map((t) => <span>{t}<span class="ml-12 text-accent">✦</span></span>))}
    </div>
  </div>
  <div class="grid h-16 grid-cols-[1fr_auto_1fr] items-center gap-2 px-2 md:gap-4 md:px-8">
    <MobileMenu client:load nav={NAV} />
    <nav data-main-nav class="hidden min-w-0 items-center gap-5 md:flex">
      {NAV.map((tab) => (
        <div class="group relative">
          <a href={tab.href} class="eyebrow flex items-center gap-1 py-5 whitespace-nowrap">
            <span class="link-line">{tab.label}</span>
            <ChevronDown size={12} strokeWidth={1.5} class="transition-transform group-focus-within:rotate-180 md:group-hover:rotate-180" />
          </a>
          <div data-dropdown class="animate-fade-in absolute top-full left-0 z-50 hidden md:group-focus-within:block md:group-hover:block">
            <ul class="min-w-[240px] border border-ink bg-canvas py-2">
              {tab.items.map((item) => (
                <li>
                  <a href={item.href} class="block px-4 py-2 text-sm whitespace-nowrap hover:bg-ink hover:text-canvas">{item.label}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </nav>
    <a href="/" class="font-display text-[22px] leading-none tracking-[0.14em] whitespace-nowrap uppercase sm:text-[26px] md:text-[30px] md:tracking-[0.18em]">DCS Y2K</a>
    <div class="flex items-center justify-end md:gap-1">
      <SearchButton client:load />
      <AccountButton client:load />
      <CartButton client:load />
    </div>
  </div>
</header>

<script>
  // The header persists across view transitions, so hide open menus on navigation
  // and keep them hidden until the pointer leaves the nav.
  const nav = () => document.querySelector<HTMLElement>('[data-main-nav]');
  document.addEventListener('astro:before-swap', () => {
    (document.activeElement as HTMLElement | null)?.blur();
    nav()?.setAttribute('data-closed', '');
  });
  // Frosted, see-through header once the page is scrolled.
  const header = document.querySelector<HTMLElement>('body > header')!;
  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  document.addEventListener('astro:page-load', onScroll);

  document.addEventListener('mouseout', (e) => {
    const n = nav();
    if (n && !n.contains(e.relatedTarget as Node | null)) n.removeAttribute('data-closed');
  });
</script>
