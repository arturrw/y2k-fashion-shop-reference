---
import { FOOTER_COLUMNS, LEGAL_LINKS, SOCIAL_LINKS } from '../lib/catalog';

const ICONS: Record<string, string> = {
  instagram:
    '<rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />',
  tiktok:
    '<path d="M15 3v10.5a3.5 3.5 0 1 1-3.5-3.5" /><path d="M15 3a5 5 0 0 0 5 5" />',
};
---
<footer class="border-t border-ink">
  <div class="grid grid-cols-2 gap-8 px-4 py-14 md:grid-cols-4 md:px-8">
    {FOOTER_COLUMNS.map((c) => (
      <div>
        <h3 class="eyebrow mb-4 text-mute">{c.title}</h3>
        <ul class="flex flex-col gap-2 text-sm">
          {c.links.map((l) => <li><a href={l.href} class="link-line">{l.label}</a></li>)}
        </ul>
      </div>
    ))}
    <div>
      <h3 class="eyebrow mb-4 text-mute">Follow</h3>
      <ul class="flex gap-3">
        {SOCIAL_LINKS.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              class="flex size-10 items-center justify-center border border-ink transition-colors hover:bg-ink hover:text-canvas"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[s.icon]} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <p aria-hidden="true" class="font-display overflow-hidden px-4 text-[21vw] leading-[0.8] tracking-[0.02em] whitespace-nowrap uppercase select-none md:px-8">DCS Y2K</p>

  <div class="border-t border-ink">
    <div class="eyebrow flex flex-wrap items-center justify-between gap-4 px-4 py-6 text-mute md:px-8">
      <p>&copy; {new Date().getFullYear()} DCS Y2K. GDPR compliant.</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {LEGAL_LINKS.map((l) => (
          <li><a href={l.href} class="link-line hover:text-ink">{l.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>
