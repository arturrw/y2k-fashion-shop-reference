---
import { eq } from 'drizzle-orm';
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { ratingSummaries } from '../lib/reviews';
import { db } from '../db';
import { products } from '../db/schema';
import { CATEGORIES } from '../lib/catalog';
import HeroSlider from '../components/HeroSlider';

const featured = await db.select().from(products).where(eq(products.featured, true));
const ratings = await ratingSummaries(featured.map((p) => p.id));

const HERO_SLIDES = [
  { src: 'https://i.pinimg.com/1200x/36/ef/ea/36efea567b898c63124c5a898a353736.jpg', alt: 'Cyber Y2K is back' },
  { src: 'https://i.pinimg.com/1200x/34/9c/80/349c804a4137a1502ecf548d4971de22.jpg', alt: 'Chains, white tank and baggy denim on the street' },
  { src: 'https://i.pinimg.com/1200x/eb/04/ba/eb04bab683decb6d7a6896581f3ebd2b.jpg', alt: 'Leopard beanie and oversized chrome shades' },
  { src: 'https://i.pinimg.com/1200x/0c/96/44/0c9644bd9d3a9874d94361be0c22344b.jpg', alt: 'Cargo pants and a cropped top on a rainy night' },
  { src: 'https://i.pinimg.com/1200x/32/21/54/32215463f48a14dbcc62ef73daa76c96.jpg', alt: 'Star-patched baggy jeans with a denim bandeau' },
  { src: 'https://i.pinimg.com/1200x/5b/35/ce/5b35cefc7707e1d62a377e7991800055.jpg', alt: 'Oversized suit shot from above in a parking garage' },
  { src: 'https://i.pinimg.com/1200x/8b/7f/17/8b7f1745ad38abe89d1794f73ff876e4.jpg', alt: 'Washed denim mini skirt with slouchy boots' },
];
const CATEGORY_IMAGES: Record<string, string> = {
  jeans: 'https://i.pinimg.com/736x/ba/66/7c/ba667c05430c38d76b4e918fb2200603.jpg',
  hoodies: 'https://i.pinimg.com/736x/7f/a1/03/7fa103937eeb2a437ecd49e150d7f15f.jpg',
  jackets: 'https://i.pinimg.com/736x/3a/eb/a9/3aeba9058b10e67d3b69ed2d2b19e0ff.jpg',
  tops: 'https://i.pinimg.com/736x/b0/c5/c0/b0c5c040869f0bb564e2e80d79065d0a.jpg',
  sunglasses: 'https://i.pinimg.com/736x/10/72/87/1072872677611a93d5894e509408e8bb.jpg',
  belts: 'https://i.pinimg.com/736x/9f/81/59/9f815962878e4b3dbf5d0197462b5189.jpg',
  jewelry: 'https://i.pinimg.com/736x/98/e4/15/98e415fff0a9d71959550f5eabc8f749.jpg',
  bags: 'https://i.pinimg.com/736x/ec/ca/51/ecca51ddc5627694b27b5d996fbf5ad1.jpg',
};
---
<Layout>
  <section class="relative h-[calc(100svh-5.85rem)] min-h-[600px] overflow-hidden border-b border-ink bg-ink">
    <HeroSlider client:load slides={HERO_SLIDES} />
    <div class="pointer-events-none absolute inset-0 flex flex-col justify-between p-6 text-white md:p-10">
      <div class="eyebrow flex justify-between gap-4 text-white/80">
        <span>Collection 01</span>
        <span class="hidden md:inline">Paris — Tokyo — Los Angeles</span>
        <span>SS—27</span>
      </div>
      <div class="reveal mb-16 max-w-[900px]">
        <h1 class="h-display mb-6 text-[64px] md:text-[clamp(80px,9vw,156px)]">Cyber <em>Y2K</em> is back.</h1>
        <p class="mb-8 max-w-[420px] leading-relaxed text-white/85">Low-rise denim, chrome hoodies and bedazzled everything — an archive of the millennium, re-cut for now. Hand-picked, shipped worldwide.</p>
        <div class="pointer-events-auto flex flex-wrap gap-3">
          <a href="/shop?gender=women" class="eyebrow inline-flex h-12 items-center bg-canvas px-7 text-ink transition-colors hover:bg-accent">Shop women's</a>
          <a href="/shop?gender=men" class="eyebrow inline-flex h-12 items-center border border-white px-7 text-white transition-colors hover:bg-white hover:text-ink">Shop men's</a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-ink py-12">
    <div class="mb-8 flex items-end justify-between px-4 md:px-8">
      <h2 class="h-display text-[40px] md:text-[56px]">The <em>Index</em></h2>
      <span class="eyebrow text-mute">({String(CATEGORIES.length).padStart(2, '0')}) Categories</span>
    </div>
    <div class="category-marquee overflow-hidden">
      <div class="category-track flex w-max">
        {[false, true].map((duplicate) =>
          CATEGORIES.map((c, i) => (
            <a
              href={`/shop?category=${c.key}`}
              class="group w-[220px] shrink-0 border-r border-hairline px-4 md:w-[260px]"
              aria-hidden={duplicate ? 'true' : undefined}
              tabindex={duplicate ? -1 : undefined}
            >
              <div class="mb-3 aspect-[3/4] overflow-hidden bg-surface-card">
                <img src={CATEGORY_IMAGES[c.key]} alt="" loading="lazy" class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.04]" />
              </div>
              <span aria-hidden="true" class="eyebrow mr-2 text-mute">{String(i + 1).padStart(2, '0')}</span>
              <span class="link-line text-sm">{c.label}</span>
            </a>
          )),
        )}
      </div>
    </div>
  </section>

  <section class="px-4 py-12 md:px-8">
    <div class="mb-8 flex items-end justify-between border-b border-hairline pb-4">
      <h2 id="trending" class="h-display scroll-mt-28 text-[40px] md:text-[56px]">Selected <em>pieces</em></h2>
      <a href="/shop" class="eyebrow link-line">View all</a>
    </div>
    <div class="grid grid-cols-2 gap-x-4 md:grid-cols-3 lg:grid-cols-4">
      {featured.map((p, i) => <ProductCard product={p} index={i} rating={ratings.get(p.id)} />)}
    </div>
  </section>

  <section class="flex flex-col items-start gap-8 bg-surface-dark px-4 py-20 text-canvas md:flex-row md:items-end md:justify-between md:px-8">
    <h2 class="h-display max-w-[900px] text-[44px] md:text-[80px]">Free worldwide shipping on <em>every</em> order.</h2>
    <a href="/shop" class="eyebrow inline-flex h-12 shrink-0 items-center bg-accent px-7 text-ink transition-colors hover:bg-canvas">Shop now</a>
  </section>
</Layout>
