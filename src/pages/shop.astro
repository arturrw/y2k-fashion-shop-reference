---
import { and, eq, ilike, inArray, or } from 'drizzle-orm';
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { ratingSummaries } from '../lib/reviews';
import { db } from '../db';
import { products } from '../db/schema';
import { ACCESSORY_CATS, CATEGORIES } from '../lib/catalog';
import { likePattern } from '../lib/search';

const gender = Astro.url.searchParams.get('gender') ?? 'all';
const category = Astro.url.searchParams.get('category') ?? 'all';
const q = (Astro.url.searchParams.get('q') ?? '').trim();

const filters = [];
if (gender === 'women' || gender === 'men') filters.push(or(eq(products.gender, gender), eq(products.gender, 'unisex')));
if (category === 'accessories') filters.push(inArray(products.category, ACCESSORY_CATS));
else if (category !== 'all') filters.push(eq(products.category, category));

if (q) filters.push(or(ilike(products.name, likePattern(q)), ilike(products.description, likePattern(q))));

const items = await db.select().from(products).where(and(...filters));
const ratings = await ratingSummaries(items.map((p) => p.id));

const title = q ? `Results for “${q}”` : gender === 'women' ? "Women's Y2K" : gender === 'men' ? "Men's Y2K" : 'All Y2K';
const href = (g: string, c: string) => {
  const p = new URLSearchParams();
  if (g !== 'all') p.set('gender', g);
  if (c !== 'all') p.set('category', c);
  if (q) p.set('q', q);
  return `/shop${p.size ? '?' + p : ''}`;
};
const chip = (active: boolean) =>
  `eyebrow inline-flex h-9 shrink-0 items-center border px-4 whitespace-nowrap transition-colors ${active ? 'border-ink bg-ink text-canvas' : 'border-hairline hover:border-ink'}`;
const genders = [['all', 'Everything'], ['women', "Women's"], ['men', "Men's"]];
---
<Layout title={`${title} — DCS Y2K`}>
  <div class="px-4 py-10 md:px-8">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-x-6 gap-y-2 border-b border-ink pb-6 md:mb-10">
      <h1 class="h-display text-[48px] md:text-[88px]"><a href="/shop" title="Show everything" class="transition-opacity hover:opacity-60">{title}</a></h1>
      <span class="eyebrow shrink-0 text-mute">({String(items.length).padStart(2, '0')}) Pieces</span>
    </div>
    <!-- on phones each filter row is one swipeable line instead of a wrapped wall of chips -->
    <div class="mb-4 flex flex-col gap-2 md:flex-row md:items-center">
      <span class="eyebrow shrink-0 text-mute md:w-24">Edit</span>
      <div class="no-scrollbar -mx-4 flex gap-2 overflow-x-auto px-4 md:mx-0 md:flex-wrap md:px-0">
        {genders.map(([k, l]) => <a href={href(k, category)} class={chip(gender === k)}>{l}</a>)}
      </div>
    </div>
    <div class="mb-12 flex flex-col gap-2 md:flex-row md:items-center">
      <span class="eyebrow shrink-0 text-mute md:w-24">Category</span>
      <div class="no-scrollbar -mx-4 flex gap-2 overflow-x-auto px-4 md:mx-0 md:flex-wrap md:px-0">
        <a href={href(gender, 'all')} class={chip(category === 'all')}>All</a>
        {CATEGORIES.map((c) => <a href={href(gender, c.key)} class={chip(category === c.key)} data-chip-active={category === c.key || undefined}>{c.label}</a>)}
      </div>
    </div>
    {items.length === 0
      ? <p class="h-display py-24 text-center text-[32px] text-mute">{q ? `No products found for “${q}”.` : 'Nothing here yet.'}</p>
      : <div class="mb-16 grid grid-cols-2 gap-x-4 md:grid-cols-3 lg:grid-cols-4">{items.map((p, i) => <ProductCard product={p} index={i} rating={ratings.get(p.id)} />)}</div>}
  </div>
</Layout>

<script>
  // On phones the category row scrolls sideways: bring the selected chip into view.
  document.addEventListener('astro:page-load', () => {
    const chip = document.querySelector<HTMLElement>('[data-chip-active]');
    const row = chip?.parentElement;
    if (chip && row && row.scrollWidth > row.clientWidth) row.scrollLeft = chip.offsetLeft - row.clientWidth / 2 + chip.offsetWidth / 2;
  });
</script>
