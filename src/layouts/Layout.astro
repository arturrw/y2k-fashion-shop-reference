---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer';
import { ClientRouter } from 'astro:transitions';

interface Props { title?: string }
const { title = 'DCS Y2K — cyber Y2K fashion' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;1,6..96,400&family=IBM+Plex+Mono:wght@400;500&family=Inter+Tight:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <Header />
    <main transition:animate="fade"><slot /></main>
    <Footer />
    <CartDrawer client:load transition:persist="cart-drawer" />
    <script>
      // Morph only the clicked card into the product photo. Naming every card would make the
      // browser snapshot each image on every navigation, which is what made opening a product lag.
      document.addEventListener('click', (e) => {
        const link = (e.target as Element).closest?.('a[href^="/product/"]');
        const image = link?.querySelector<HTMLElement>('[data-product-image]');
        if (image) image.style.viewTransitionName = `product-${image.dataset.productImage}`;
      });
    </script>
  </body>
</html>
