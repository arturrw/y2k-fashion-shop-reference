---
import CartButton from './CartButton';
import { Search, User } from 'lucide-react';

const links = [
  { label: 'All', href: '/shop' },
  { label: 'Mens', href: '/shop?gender=men' },
  { label: 'Womens', href: '/shop?gender=women' },
  { label: 'Themed Collections', href: '/shop?category=accessories' },
  { label: 'New Collections', href: '/shop' },
];
---
<header transition:persist="site-header" class="sticky top-0 z-50 flex h-16 items-center justify-between gap-4 border-b border-hairline bg-canvas px-6">
  <a href="/" class="font-display text-xl font-bold tracking-tight whitespace-nowrap">DCS Y2K</a>
  <nav class="flex min-w-0 flex-1 items-center justify-center gap-6 overflow-x-auto">
    {links.map((l) => <a href={l.href} class="text-sm font-semibold whitespace-nowrap">{l.label}</a>)}
  </nav>
  <div class="flex items-center gap-3">
    <a href="/shop" aria-label="Search" class="flex size-10 items-center justify-center rounded-full hover:bg-secondary"><Search size={18} /></a>
    <button aria-label="Account" class="flex size-10 items-center justify-center rounded-full hover:bg-secondary"><User size={18} /></button>
    <CartButton client:load />
  </div>
</header>
