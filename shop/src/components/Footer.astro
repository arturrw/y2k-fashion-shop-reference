---
import { FOOTER_COLUMNS } from '../lib/catalog';
---
<footer class="border-t border-hairline">
  <div class="mx-auto grid max-w-[1280px] grid-cols-2 gap-8 px-6 py-12 md:grid-cols-4">
    {FOOTER_COLUMNS.map((c) => (
      <div>
        <h3 class="mb-3 text-sm font-semibold">{c.title}</h3>
        <ul class="flex flex-col gap-2 text-sm text-mute">
          {c.links.map((l) => <li><a href="#" class="hover:text-ink">{l}</a></li>)}
        </ul>
      </div>
    ))}
  </div>
</footer>
